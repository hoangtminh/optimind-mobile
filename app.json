{
  "expo": {
    "name": "Optimind",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2D185C"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#411270"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "@react-native-community/datetimepicker",
      "react-native-orientation-director",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": ["**/libmix.so"]
            },
            "noCompress": ["task", "tflite"],
            "extraProguardRules": "-dontwarn javax.lang.model.**\n-keep class javax.lang.model.** { *; }\n-dontwarn autovalue.shaded.com.squareup.javapoet.**\n-keep class autovalue.shaded.com.squareup.javapoet.** { *; }\n-dontwarn com.google.auto.value.**\n-keep class com.google.auto.value.** { *; }\n-keep class com.google.mediapipe.** { *; }\n-dontwarn com.google.mediapipe.**\n-keep class org.tensorflow.lite.** { *; }\n-dontwarn org.tensorflow.lite.**\n-keepclasseswithmembernames class * { native <methods>; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08e3ccde-bb75-4d67-850c-876653919676"
      }
    }
  }
}
