{
  "cli": {
    "version": ">= 18.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=8192"
        },
        "resourceClass": "large"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
